---
import BaseLayout from '../layouts/BaseLayout.astro';

const startingPoints = [
  {
    title: 'The outcome',
    copy: 'What should be easier, faster, clearer or newly possible when the work is finished?',
  },
  {
    title: 'The people',
    copy: 'Who will use it, manage it or depend on it? That usually matters more than choosing a technology up front.',
  },
  {
    title: 'The boundaries',
    copy: 'Deadlines, existing systems, budgets, hosting constraints or anything that must not change belong in the conversation early.',
  },
  {
    title: 'The unknowns',
    copy: 'You do not need to solve every detail before getting in touch. Uncertainty is useful information when it is made visible.',
  },
] as const;

const nextSteps = [
  {
    title: 'Review the requirement',
    copy: 'We start by understanding the result you need rather than immediately turning a short message into a fixed technical solution.',
  },
  {
    title: 'Clarify the gaps',
    copy: 'Questions are used to remove uncertainty, expose dependencies and separate essential work from optional ideas.',
  },
  {
    title: 'Scope the actual job',
    copy: 'Once the work is understood, Blackline can establish the base job price and explain what is included and excluded.',
  },
  {
    title: 'Choose the delivery pace',
    copy: 'If you proceed, Standard, Priority or Accelerated is selected after the base scope is priced. The tier does not redefine the job.',
  },
] as const;
---

<BaseLayout title="Contact" description="Start a website, software, automation or managed-service conversation with Blackline Development.">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Start a project</p>
        <h1>Start with what needs to work better.</h1>
        <p class="hero-copy">
          You do not need a finished specification. A useful first conversation is about the outcome, the people involved, the boundaries and the things that are still uncertain.
        </p>
        <div class="hero-actions">
          <a class="button" href="mailto:support@blacklinedevelopment.uk">Email Blackline</a>
          <a class="button secondary" href="/services">Review services</a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="Project contact">
        <strong>One useful message is enough.</strong>
        <p>Email <a class="inline-link" href="mailto:support@blacklinedevelopment.uk">support@blacklinedevelopment.uk</a> with the outcome you need and anything you already know. Unknowns can stay unknown until discovery.</p>
      </aside>
    </div>
  </section>

  <section class="section process-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">What to bring</p>
          <h2>Four things are enough to start.</h2>
        </div>
        <p>
          The aim is not to make you write Blackline's specification for us. Give us enough context to understand the problem and keep the things you do not know visible.
        </p>
      </div>

      <div class="process-list" aria-label="Useful project starting information">
        {startingPoints.map((item, index) => (
          <article class="process-step">
            <span class="process-number" aria-hidden="true">0{index + 1}</span>
            <div class="process-copy">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">What happens next</p>
          <h2>Understanding comes before quoting.</h2>
        </div>
        <p>
          A reliable quote needs a reliable scope. Blackline separates discovery, base job pricing and service-tier choice so speed does not get confused with what is actually being built.
        </p>
      </div>

      <div class="process-list" aria-label="Blackline project intake steps">
        {nextSteps.map((item, index) => (
          <article class="process-step">
            <span class="process-number" aria-hidden="true">0{index + 1}</span>
            <div class="process-copy">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container status-band">
      <div>
        <p class="eyebrow">Ready to talk?</p>
        <h2>Send the first message.</h2>
      </div>
      <div>
        <p>
          Use the business support mailbox for project enquiries. The website does not collect project details, credentials, payment information or documents through an unverified public form.
        </p>
        <a class="text-link" href="mailto:support@blacklinedevelopment.uk">support@blacklinedevelopment.uk <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
