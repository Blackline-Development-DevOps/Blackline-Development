---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/intake.css';

const intakeSteps = [
  {
    title: 'Tell us the outcome',
    copy: 'Describe what should be easier, clearer or newly possible when the work is finished.',
  },
  {
    title: 'Add what you already know',
    copy: 'Existing systems, deadlines and constraints help. Anything uncertain can stay marked as unsure.',
  },
  {
    title: 'Review before sending',
    copy: 'The site prepares a structured email in your own mail app. Nothing is silently submitted or stored by the website.',
  },
] as const;
---

<BaseLayout title="Contact" description="Start a general enquiry or prepare a commissioned-development request for Blackline Development.">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Start here</p>
        <h1>Choose the simplest way to get in touch.</h1>
        <p class="hero-copy">
          A quick question does not need a project form. A commissioned build benefits from a little structure. Pick the path that matches what you need.
        </p>
      </div>
      <aside class="hero-aside" aria-label="Contact privacy">
        <strong>No account required.</strong>
        <p>This page does not upload files, collect payment details or store your project information on the website.</p>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-path-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Choose a path</p>
          <h2 id="contact-path-heading">What are you here for?</h2>
        </div>
        <p>Both routes reach Blackline Development. The difference is how much structure helps before the first human review.</p>
      </div>

      <div class="intake-choice-grid">
        <article class="intake-choice">
          <span class="card-index">01</span>
          <h3>General enquiry</h3>
          <p>Questions about Blackline, an existing service, managed services or something that does not need a full project brief.</p>
          <a class="button" href="mailto:support@blacklinedevelopment.uk?subject=General%20enquiry">Email Blackline</a>
        </article>

        <article class="intake-choice">
          <span class="card-index">02</span>
          <h3>Commissioned development</h3>
          <p>Websites, applications, bots, automation or integrations where a structured first message will make scoping easier.</p>
          <a class="button secondary" href="#project-intake">Prepare a project request</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section process-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Project requests</p>
          <h2>Useful context without a giant form.</h2>
        </div>
        <p>You do not need to know the technology, final scope or exact budget. Give us the outcome and the important boundaries; unknowns are valid information.</p>
      </div>

      <div class="process-list" aria-label="Commission intake process">
        {intakeSteps.map((step, index) => (
          <article class="process-step">
            <span class="process-number" aria-hidden="true">0{index + 1}</span>
            <div class="process-copy">
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="project-intake" aria-labelledby="project-intake-heading">
    <div class="container intake-shell">
      <div class="intake-intro">
        <p class="eyebrow">Commission request</p>
        <h2 id="project-intake-heading">Prepare the first message.</h2>
        <p>
          This is a review request, not an acceptance, quote, payment instruction or booking. Blackline will review the requirement before any scope or price is agreed.
        </p>

        <div class="privacy-note" role="note">
          <strong>Do not include</strong>
          <p>Passwords, API keys, access tokens, card/bank information, personal documents or other secrets. Those are never needed for an initial request.</p>
          <p><a class="inline-link" href="/privacy">Read how email enquiries are handled</a></p>
        </div>
      </div>

      <form class="intake-form" id="commission-intake-form">
        <div class="field">
          <label for="contact-name">Your name <span class="optional">(optional)</span></label>
          <input id="contact-name" name="contactName" type="text" autocomplete="name" maxlength="100" />
        </div>

        <div class="field">
          <label for="project-type">What best matches the request?</label>
          <select id="project-type" name="projectType" required>
            <option value="">Choose one</option>
            <option>Website</option>
            <option>Web or desktop application</option>
            <option>Discord bot</option>
            <option>Automation or integration</option>
            <option>Managed service</option>
            <option>Not sure / needs discussion</option>
          </select>
        </div>

        <div class="field">
          <label for="project-outcome">What should be different when the work is finished?</label>
          <textarea
            id="project-outcome"
            name="outcome"
            rows="6"
            maxlength="1200"
            required
            aria-describedby="outcome-help"
          ></textarea>
          <p class="field-help" id="outcome-help">Describe the result in your own words. Technical terminology is not required.</p>
        </div>

        <details class="intake-details">
          <summary>Add more context <span>Optional</span></summary>
          <div class="details-fields">
            <div class="field">
              <label for="current-setup">What exists today? <span class="optional">(optional)</span></label>
              <textarea id="current-setup" name="currentSetup" rows="4" maxlength="1200"></textarea>
            </div>

            <div class="field">
              <label for="constraints">Anything that must not change? <span class="optional">(optional)</span></label>
              <textarea id="constraints" name="constraints" rows="4" maxlength="1200"></textarea>
            </div>

            <div class="field">
              <label for="timeline">Is there a timing constraint?</label>
              <select id="timeline" name="timeline">
                <option>No fixed date</option>
                <option>As soon as practical</option>
                <option>Within a month</option>
                <option>Within three months</option>
                <option>Specific deadline — explain in the message</option>
                <option>Not sure / needs discussion</option>
              </select>
            </div>
          </div>
        </details>

        <div class="intake-actions">
          <button class="button" type="submit">Prepare email</button>
          <p class="field-help">
            Nothing is sent when you press this button. Your email app opens with a structured draft for you to review and send.
          </p>
        </div>

        <p class="form-status" id="intake-status" role="status" aria-live="polite"></p>

        <noscript>
          <p class="noscript-note">
            JavaScript is disabled, so the structured draft cannot be prepared automatically.
            <a class="inline-link" href="mailto:support@blacklinedevelopment.uk?subject=Project%20enquiry">Email support@blacklinedevelopment.uk</a> instead.
          </p>
        </noscript>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="container status-band">
      <div>
        <p class="eyebrow">After you send</p>
        <h2>Human review comes next.</h2>
      </div>
      <div>
        <p>
          Blackline reviews the request, identifies missing decisions and determines whether more discovery is needed. A request does not create approved implementation work, a final quote, a payment obligation or a delivery date.
        </p>
        <a class="text-link" href="/commissions">See how commissioned work is priced <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector('#commission-intake-form');
    const status = document.querySelector('#intake-status');

    if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();

        if (!form.reportValidity()) {
          status.textContent = 'Check the required fields before preparing the email.';
          return;
        }

        const data = new FormData(form);
        const projectType = String(data.get('projectType') ?? '').trim();
        const contactName = String(data.get('contactName') ?? '').trim();
        const outcome = String(data.get('outcome') ?? '').trim();
        const currentSetup = String(data.get('currentSetup') ?? '').trim();
        const constraints = String(data.get('constraints') ?? '').trim();
        const timeline = String(data.get('timeline') ?? '').trim();

        const lines = [
          'Blackline Development — commission request',
          '',
          `Project type: ${projectType || 'Not sure / needs discussion'}`,
          `Name: ${contactName || 'Not provided'}`,
          '',
          'Desired outcome:',
          outcome,
          '',
          'Current setup:',
          currentSetup || 'Not provided / needs discussion',
          '',
          'Constraints:',
          constraints || 'Not provided / needs discussion',
          '',
          `Timing: ${timeline || 'Not sure / needs discussion'}`,
          '',
          'I understand this request is for review and does not itself confirm scope, price, payment, scheduling or implementation.',
        ];

        const subject = `Project enquiry — ${projectType || 'Needs discussion'}`;
        const mailto = `mailto:support@blacklinedevelopment.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;

        status.textContent = 'Opening your email app with a draft. Review it before sending.';
        window.location.href = mailto;
      });
    }
  </script>
</BaseLayout>
