---
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/brand.css';
import '../styles/experience.css';
import '../styles/accessibility.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.name,
  description = site.description,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const path = Astro.url.pathname;
const canonicalUrl = new URL(path, Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080808" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index,follow" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/jpeg" href="/brand/blackline-development/logo-primary-on-dark.jpg" />
    <link rel="apple-touch-icon" href="/brand/blackline-development/logo-primary-on-dark.jpg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="container nav-shell">
        <a class="wordmark" href="/" aria-label="Blackline Development home">
          <img
            class="wordmark-mark"
            src="/brand/blackline-development/logo-primary-on-dark.jpg"
            width="36"
            height="36"
            alt=""
            aria-hidden="true"
          />
          <span>Blackline Development</span>
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
          {site.navigation.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href={site.primaryAction.href}>{site.primaryAction.label}</a>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>Blackline Development</strong><br />
          Software, websites, automation and managed services.
        </div>
        <div>
          Pricing shown on this site is subject to the current Blackline Development catalogue and quote terms.
        </div>
      </div>
    </footer>
  </body>
</html>
