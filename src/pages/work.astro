---
import BaseLayout from '../layouts/BaseLayout.astro';

const evidenceStandards = [
  {
    title: 'The problem',
    copy: 'What was not working, who it affected and why existing tools or approaches were not enough.',
  },
  {
    title: 'The build',
    copy: 'What Blackline actually delivered, described plainly enough to understand without burying the outcome in technical detail.',
  },
  {
    title: 'The constraints',
    copy: 'The important boundaries, trade-offs and decisions that shaped the work instead of pretending every project was frictionless.',
  },
  {
    title: 'The outcome',
    copy: 'What changed once the work was delivered, using only results that can be supported and approved for public use.',
  },
] as const;

const capabilityAreas = [
  ['Web', 'Public websites, service journeys and web platforms.'],
  ['Software', 'Purpose-built desktop and web applications.'],
  ['Automation', 'Bots, integrations and operational workflows.'],
  ['Managed delivery', 'Projects where Blackline continues to host, maintain or operate the supporting service.'],
] as const;
---

<BaseLayout title="Work" description="Selected Blackline Development work and the evidence standards used for public case studies.">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Selected work</p>
        <h1>Work should prove something.</h1>
        <p class="hero-copy">
          Blackline case studies will show the problem, the work, the important constraints and the result. If those details are not approved or supportable, we do not turn them into marketing claims.
        </p>
      </div>
      <aside class="hero-aside" aria-label="Portfolio standard">
        <strong>No filler portfolio.</strong>
        <p>Projects are published when there is real work to show and permission to show it properly — not to make a grid look busy.</p>
      </aside>
    </div>
  </section>

  <section class="section process-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Evidence standard</p>
          <h2>Every case study has to earn its place.</h2>
        </div>
        <p>
          Public work should help a prospective client understand how Blackline thinks and delivers. It should not expose confidential information or rely on vague claims that cannot be checked.
        </p>
      </div>

      <div class="process-list" aria-label="Case study evidence standard">
        {evidenceStandards.map((item, index) => (
          <article class="process-step">
            <span class="process-number" aria-hidden="true">0{index + 1}</span>
            <div class="process-copy">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container proof-state">
      <div>
        <p class="eyebrow">Public case studies</p>
        <h2>Being prepared deliberately.</h2>
      </div>
      <div class="proof-state-copy">
        <p>
          The portfolio is intentionally not padded with invented client names, placeholder screenshots, testimonials or vanity metrics. Approved project stories will appear here as they are ready for public use.
        </p>
        <a class="text-link" href="/contact">Discuss a similar requirement <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Capability areas</p>
          <h2>The kinds of work this portfolio is built to show.</h2>
        </div>
        <p>These are capability categories, not claims about unnamed customers. Case studies will sit beneath them only when the underlying work can be published responsibly.</p>
      </div>

      <div class="capability-list">
        {capabilityAreas.map(([title, copy]) => (
          <div class="capability-row">
            <h3>{title}</h3>
            <p>{copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
